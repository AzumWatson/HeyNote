{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "HeyNote Xiaoheishu",
  "short_name": "HeyNote",
  "version": "0.8.0",
  "description": "Switch between the original Xiaoheihe forum and the HeyNote browsing experience.",
  "permissions": ["storage", "scripting", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://www.xiaoheihe.cn/*",
    "https://api.xiaoheihe.cn/*",
    "*://*.max-c.com/*",
    "*://*.xiaoheihe.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaoheihe.cn/app/bbs/home*"],
      "js": ["domain-claim.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.xiaoheihe.cn/app/search*"],
      "js": ["search-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open HeyNote Xiaoheishu"
  }
}
